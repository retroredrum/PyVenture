{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/retroredrum/PyVenture/schema/game.schema.json",
  "title": "PyVenture game project",
  "description": "Schéma du format de contenu PyVenture (format_version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "meta", "languages", "rooms"],
  "properties": {
    "format": { "const": "pyventure-game" },
    "format_version": { "const": 1 },
    "meta": { "$ref": "#/$defs/meta" },
    "languages": {
      "type": "array",
      "items": { "$ref": "#/$defs/language_code" },
      "minItems": 1,
      "uniqueItems": true
    },
    "flags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "counters": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "vocabulary": { "$ref": "#/$defs/vocabulary" },
    "messages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/localized_text" }
    },
    "rooms": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/room" },
      "minProperties": 1
    },
    "objects": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/object" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    },
    "endings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/ending" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Identifiant stable en slug."
    },
    "language_code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "Code de langue BCP-47 court, par exemple fr, en ou pt-BR."
    },
    "localized_text": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/language_code" },
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "art_path": {
      "type": "string",
      "minLength": 1,
      "description": "Chemin relatif à la racine du projet."
    },
    "message_ref": {
      "$ref": "#/$defs/localized_text",
      "description": "Clé de message ou texte localisé inline."
    },
    "condition_list": {
      "oneOf": [
        { "$ref": "#/$defs/condition" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" },
          "minItems": 1
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["has"],
          "properties": { "has": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_has"],
          "properties": { "not_has": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag"],
          "properties": { "flag": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_flag"],
          "properties": { "not_flag": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["room"],
          "properties": { "room": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_state"],
          "properties": {
            "object_state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object", "state"],
              "properties": {
                "object": { "$ref": "#/$defs/id" },
                "state": { "$ref": "#/$defs/id" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["counter"],
          "properties": {
            "counter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "$ref": "#/$defs/id" },
                "eq": { "type": "integer" },
                "gte": { "type": "integer" },
                "lte": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score"],
          "properties": {
            "score": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "eq": { "type": "integer" },
                "gte": { "type": "integer" },
                "lte": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["say"],
          "properties": { "say": { "$ref": "#/$defs/message_ref" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["set_flag"],
          "properties": { "set_flag": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["clear_flag"],
          "properties": { "clear_flag": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["set_counter"],
          "properties": {
            "set_counter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "$ref": "#/$defs/id" },
                "value": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["add_counter"],
          "properties": {
            "add_counter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "delta"],
              "properties": {
                "name": { "$ref": "#/$defs/id" },
                "delta": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["move_object"],
          "properties": {
            "move_object": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object", "to"],
              "properties": {
                "object": { "$ref": "#/$defs/id" },
                "to": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["remove_object"],
          "properties": { "remove_object": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["set_object_state"],
          "properties": {
            "set_object_state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object", "state"],
              "properties": {
                "object": { "$ref": "#/$defs/id" },
                "state": { "$ref": "#/$defs/id" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["set_room_variant"],
          "properties": {
            "set_room_variant": {
              "type": "object",
              "additionalProperties": false,
              "required": ["room", "variant"],
              "properties": {
                "room": { "$ref": "#/$defs/id" },
                "variant": { "$ref": "#/$defs/id" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["set_exit"],
          "properties": {
            "set_exit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["room", "direction", "target"],
              "properties": {
                "room": { "$ref": "#/$defs/id" },
                "direction": { "$ref": "#/$defs/id" },
                "target": { "$ref": "#/$defs/id" },
                "when": { "$ref": "#/$defs/condition_list" },
                "locked_message": { "$ref": "#/$defs/message_ref" },
                "hidden": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["remove_exit"],
          "properties": {
            "remove_exit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["room", "direction"],
              "properties": {
                "room": { "$ref": "#/$defs/id" },
                "direction": { "$ref": "#/$defs/id" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["teleport"],
          "properties": { "teleport": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score"],
          "properties": { "score": { "type": "integer" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["end_game"],
          "properties": { "end_game": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["play_sound"],
          "properties": { "play_sound": { "$ref": "#/$defs/id" } }
        }
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verbs", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "verbs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "indirect_objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "prepositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "when": { "$ref": "#/$defs/condition_list" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" },
          "minItems": 1
        },
        "once": { "type": "boolean" },
        "priority": { "type": "integer" },
        "comment": { "type": "string" }
      }
    },
    "exit": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["room"],
          "properties": {
            "room": { "$ref": "#/$defs/id" },
            "when": { "$ref": "#/$defs/condition_list" },
            "locked_message": { "$ref": "#/$defs/message_ref" },
            "hidden": { "type": "boolean" }
          }
        }
      ]
    },
    "room_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "$ref": "#/$defs/localized_text" },
        "art": { "$ref": "#/$defs/art_path" },
        "name": { "$ref": "#/$defs/localized_text" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/localized_text" },
        "description": { "$ref": "#/$defs/localized_text" },
        "art": { "$ref": "#/$defs/art_path" },
        "exits": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/exit" }
        },
        "variants": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/room_variant" }
        },
        "on_enter": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "comment": { "type": "string" }
      }
    },
    "object_state": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "description": { "$ref": "#/$defs/localized_text" },
        "art": { "$ref": "#/$defs/art_path" },
        "name": { "$ref": "#/$defs/localized_text" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/localized_text" },
        "synonyms": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/language_code" },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "description": { "$ref": "#/$defs/localized_text" },
        "location": { "type": "string", "minLength": 1 },
        "portable": { "type": "boolean" },
        "art": { "$ref": "#/$defs/art_path" },
        "states": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/object_state" }
        },
        "initial_state": { "type": "string" },
        "comment": { "type": "string" }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": { "$ref": "#/$defs/localized_text" },
        "text": { "$ref": "#/$defs/localized_text" },
        "art": { "$ref": "#/$defs/art_path" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "start_room", "default_language"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/localized_text" },
        "start_room": { "$ref": "#/$defs/id" },
        "default_language": { "$ref": "#/$defs/language_code" },
        "version": { "type": "string" },
        "max_score": { "type": "integer", "minimum": 0 },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "$ref": "#/$defs/localized_text" },
        "art": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "scale": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "word_map": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/language_code" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/id" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verbs": { "$ref": "#/$defs/word_map" },
        "directions": { "$ref": "#/$defs/word_map" },
        "prepositions": { "$ref": "#/$defs/word_map" }
      }
    }
  }
}
